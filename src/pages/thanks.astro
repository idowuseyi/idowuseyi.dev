---
import BaseLayout from '../layouts/BaseLayout.astro';

// Static redirect target for the no-JS (plain HTML form POST) contact path:
// /api/contact 303s here on success instead of baking a `?sent=1` query
// param into the prerendered homepage, which can't react to a query string
// once it's a static file. The enhanced fetch() path in ContactForm.astro
// never navigates here — it reports its own inline status instead.
---
<BaseLayout
  title="Message sent — Oluwaseyi Idowu"
  description="Your message has been sent."
  canonicalPath="/thanks"
  noindex
>
  <main class="status-page">
    <div class="wrap">
      <p class="status-page__eyebrow mono">
        <span class="status-page__dot" aria-hidden="true"></span>
        Message sent
      </p>
      <h1 class="status-page__title">Thanks for reaching out.</h1>
      <p class="status-page__body">
        I reply within two working days. In the meantime, feel free to head back to the homepage.
      </p>
      <a class="status-page__link" href="/">&larr; Back to home</a>
    </div>
  </main>
</BaseLayout>

<style>
  .status-page { padding-block: var(--space-xl); min-height: 60vh; display: flex; align-items: center; }
  .status-page__eyebrow {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--muted);
    font-size: var(--step--1);
    margin-bottom: var(--space-m);
  }
  .status-page__dot {
    width: 7px;
    height: 7px;
    flex-shrink: 0;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 18%, transparent);
  }
  .status-page__title {
    font-size: var(--step-2);
    font-weight: 600;
    letter-spacing: -0.02em;
    margin-bottom: var(--space-m);
  }
  .status-page__body { color: var(--muted); max-width: 60ch; margin-bottom: var(--space-l); }
  .status-page__link { color: var(--accent); font-weight: 500; }
</style>
