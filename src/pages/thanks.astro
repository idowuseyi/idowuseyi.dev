---
import StatusPage from '../layouts/StatusPage.astro';

// Static redirect target for the no-JS (plain HTML form POST) contact path:
// /api/contact 303s here on success instead of baking a `?sent=1` query
// param into the prerendered homepage, which can't react to a query string
// once it's a static file. The enhanced fetch() path in ContactForm.astro
// never navigates here — it reports its own inline status instead.
---
<StatusPage
  title="Message sent — Oluwaseyi Idowu"
  description="Your message has been sent."
  heading="Thanks for reaching out."
  canonicalPath="/thanks/"
>
  <p slot="eyebrow" class="status-page__eyebrow mono">
    <span class="status-page__dot" aria-hidden="true"></span>
    Message sent
  </p>
  <p class="status-page__body">
    I reply within two working days. In the meantime, feel free to head back to the homepage.
  </p>
  <a class="status-page__link" href="/">&larr; Back to home</a>
</StatusPage>
