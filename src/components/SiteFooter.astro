---
import { profile } from '../data/profile';

// Lived in index.astro, so six of the seven page types ended with no footer,
// no copyright line and no contentinfo landmark. Rendered from BaseLayout now,
// so a page cannot be built without one.
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="wrap footer__inner mono">
    <span>© {year} {profile.name}</span>
    <a href="/rss.xml">RSS</a>
  </div>
</footer>

<style>
  .footer {
    padding-block: var(--space-l);
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: var(--step--1);
  }
  .footer__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-m);
  }
  .footer a { color: var(--muted); text-decoration: none; }
  .footer a:hover { color: var(--text); }
</style>
