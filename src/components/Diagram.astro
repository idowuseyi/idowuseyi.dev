---
interface Props {
  name: string;
  caption: string;
}

const { name, caption } = Astro.props;
// Inlined by Vite at build time (eager + `?raw`) instead of read from disk
// at render time: `import.meta.url` is undefined inside @astrojs/cloudflare's
// prerender environment, so the previous `fileURLToPath(new URL(...,
// import.meta.url))` approach threw before any file was read. `import.meta.glob`
// resolves statically at build time and has no such runtime dependency.
// Stays synchronous and uncaught: a missing or renamed SVG should fail the
// build loudly, not render an empty figure.
const svgs = import.meta.glob('../diagrams/*.svg', { query: '?raw', import: 'default', eager: true });
const svg = svgs[`../diagrams/${name}.svg`] as string | undefined;
if (!svg) throw new Error(`Diagram not found: src/diagrams/${name}.svg`);
---
<figure class="diagram">
  <div class="diagram__canvas" set:html={svg} />
  <figcaption class="diagram__caption mono">{caption}</figcaption>
</figure>

<style>
  .diagram {
    margin-block: var(--space-l);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: var(--space-l);
  }
  .diagram__canvas :global(svg) {
    width: 100%;
    height: auto;
    max-width: 100%;
  }
  .diagram__caption {
    margin-top: var(--space-m);
    color: var(--muted);
    font-size: var(--step--1);
  }
</style>
