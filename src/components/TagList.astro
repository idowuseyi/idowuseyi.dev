---
// Renders a post's tags as pills. Each pill links to its tag page at
// /writing/tags/<slug>/ by default; pass linked={false} for a plain-text
// rendering (e.g. somewhere a tag page link would be redundant or self-
// referential).
import { tagSlug } from '../lib/tags';

interface Props {
  tags: string[];
  linked?: boolean;
}

const { tags, linked = true } = Astro.props;
---
{tags.length > 0 && (
  <ul class="tag-list mono">
    {tags.map((tag) => (
      <li class="tag-list__item">
        {linked
          ? <a class="tag-list__link" href={`/writing/tags/${tagSlug(tag)}/`}>{tag}</a>
          : tag}
      </li>
    ))}
  </ul>
)}

<style>
  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
    list-style: none;
  }

  .tag-list__item {
    font-size: var(--step--1);
    color: var(--muted);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 0.2em 0.6em;
  }

  .tag-list__link {
    color: inherit;
    text-decoration: none;
  }

  .tag-list__item:hover {
    border-color: var(--text);
  }

  .tag-list__item:hover .tag-list__link {
    color: var(--text);
  }
</style>
