{
  "name": "idowuseyi-dev",
  "version": "1.0.0",
  "description": "Oluwaseyi Idowu's recruiter-facing portfolio — Astro, static output, deployed to Cloudflare.",
  "scripts": {
    "dev": "astro dev",
